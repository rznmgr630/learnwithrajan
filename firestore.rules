rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/todos/{todoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/projects/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/learning/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/learningProgress/{progressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/budget/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "rajanmidun@gmail.com";
    }

    match /users/{userId}/budget/{documentId}/{subcollection}/{entry} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "rajanmidun@gmail.com";
    }

    match /users/{userId}/budget/{documentId}/{subcollection}/{entry}/{nestedCollection}/{nestedEntry} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "rajanmidun@gmail.com";
    }

    match /users/{userId}/workHours/{workdayId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['jobName'])
        && request.resource.data.jobName is string
        && request.resource.data.jobName.size() > 0;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/workJobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
